# Demo only. Put actual credentials in a local .env or secret manager; never commit them.

# Local/deployment values only. Never commit .env or copy real customer secrets here.

# AgentKit MCP custom-private backend image in your Volcengine Container Registry.
EMS_MCP_IMAGE=your-registry.example.com/ems-demo/ems-governance:demo

# Fill these from the AgentKit MCP service details after creating the service.
EMS_DEMO_MCP_URL=
EMS_DEMO_MCP_AUTH_KEY=

# AgentKit schedule-checker Runtime. First deployment can use this placeholder;
# replace it with the A2A URL shown in the Runtime details, then redeploy.
EMS_SCHEDULE_CHECKER_PUBLIC_URL=https://localhost.invalid
EMS_SCHEDULE_CHECKER_AGENT_CARD_URL=
EMS_SCHEDULE_CHECKER_A2A_AUTH_KEY=

# Synthetic principal shown in demo Grant/audit responses.
EMS_DEMO_OPERATOR_SUBJECT=demo.operator

# Local-only reviewer/Worker demo secrets; keep them different from MCP and Runtime keys.
EMS_DEMO_GRANT_REVIEWER_KEY=
EMS_DEMO_CHANGESET_REVIEWER_KEY=
EMS_DEMO_WORKER_KEY=

# Keep mock unless the customer has approved a non-production SimplyBook endpoint.
EMS_SIMPLYBOOK_MODE=mock
SIMPLY_BOOK_API_BASE_URL=
SIMPLY_BOOK_JWT=
SIMPLY_BOOK_APP_ID=
SIMPLY_BOOK_PLATFORM=
